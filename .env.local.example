# 회사↔집 동기화(Supabase)를 켜는 두 값.
# 이 파일을 복사해 `.env.local` 로 저장하고 값을 채운 뒤 dev 서버를 재시작하면 자동으로 붙는다.
# (자세한 설정은 src/boundary/store/supabase.ts 상단 주석 참고)
#
#   cp .env.local.example .env.local
#
# 값이 없으면 앱은 로컬(localStorage) 전용으로 돈다 — 그대로도 완전히 동작한다.

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...여기에_anon_public_키
